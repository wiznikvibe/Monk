  "cards": [
    {
      "dot": "cyan",
      "title": "What is learned",
      "items": [
        "Only findings with severity warning or error become patterns",
        "pattern_text is the finding message string",
        "Unique key is (repo_full_name, pattern_text); frequency increments"
      ]
    },
    {
      "dot": "emerald",
      "title": "How it feeds reviews",
      "items": [
        "Orchestrator loads the ten highest-frequency patterns for the repo",
        "Only the style agent prompt includes that list",
        "Other agents do not receive learned patterns"
      ]
    },
    {
      "dot": "rose",
      "title": "Implementation caveat",
      "items": [
        "trigger_learning is registered in webhook/worker.py",
        "learner-worker Deployment runs learner image worker without that task",
        "Production learning depends on which image actually consumes Q:learning"
      ]
    }
