  "cards": [
    {
      "dot": "cyan",
      "title": "Sync edge, async core",
      "items": [
        "Gateway only verifies HMAC and forwards the raw body",
        "Webhook persists work and enqueues Celery; workers call Orchestrator",
        "Reviewer is the sole GitHub write path for PR comments"
      ]
    },
    {
      "dot": "emerald",
      "title": "Learning loop",
      "items": [
        "Merged PRs enqueue trigger_learning on the learning queue",
        "Learner upserts warning/error findings into patterns",
        "Orchestrator injects top-10 patterns into the style agent"
      ]
    },
    {
      "dot": "rose",
      "title": "Verified gaps",
      "items": [
        "trigger_learning is defined in webhook/worker.py, not learner/worker.py",
        "Service URLs are hardcoded in workers (ConfigMap URLs unused in code)",
        "Infra manifests exist; local end-to-end readiness is unverified"
      ]
    }
