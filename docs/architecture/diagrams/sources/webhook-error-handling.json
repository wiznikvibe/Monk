  "cards": [
    {
      "dot": "emerald",
      "title": "Implemented recovery",
      "items": [
        "Invalid signatures are rejected at the gateway (401)",
        "Duplicate SHA deliveries short-circuit without re-enqueue",
        "GitHub 422 on inline comments retries summary-only"
      ]
    },
    {
      "dot": "amber",
      "title": "Soft / silent paths",
      "items": [
        "Unsupported actions return skipped",
        "Malformed agent JSON becomes an empty list for that agent",
        "Empty findings return ok without marking PR reviewed"
      ]
    },
    {
      "dot": "rose",
      "title": "Missing recovery",
      "items": [
        "No Celery autoretry/backoff on analyze_pr or trigger_learning",
        "Gateway raise_for_status propagates webhook upstream failures",
        "Orchestrator and Reviewer use raise_for_status without fallbacks"
      ]
    }
  ]
